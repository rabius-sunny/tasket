              "raw": "{\n  \"title\": \"Implement user authentication\",\n  \"description\": \"Add login/register functionality with JWT tokens\",\n  \"labels\": [\"backend\", \"auth\", \"high-priority\"],\n  \"dueDate\": \"2025-07-15T10:00:00Z\",\n  \"assignedTo\": {{user_id}},\n  \"status\": \"todo\"\n}"
