# Database Configuration for Production

# PostgreSQL connection URL with connection pooling parameters
DATABASE_URL='db://your_dbe'

# Server Configuration
PORT=3000
NODE_ENV=production

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-here

# Connection Pool Settings (for manual configuration)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tasket_db
DB_USER=tasket_user
DB_PASSWORD=your_password

# PostgreSQL connection string (manual)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?pool_max=20&pool_timeout=30000&connect_timeout=30"

# Connection Pool Settings
DB_CONNECTION_LIMIT=20
DB_POOL_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=30000

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379

# File Upload Configuration
MAX_FILE_SIZE=10485760 # 10MB in bytes
UPLOAD_DIR=./uploads
